<odoo>
    <!-- Form view for property types -->
    <record id="estate_property_type_view_form" model="ir.ui.view">
        <field name="name">estate_property_type_view_form</field>
        <field name="model">estate.property.type</field>
        <field name="arch" type="xml">
            <form>
                <header></header>
                <sheet>
                    <!-- Stat button -->
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_offer_ids"
                            type="object"
                            class="oe_stat_button"
                            string="Offers"
                            icon="payments"
                        >
                            <!-- This div is for formatting, you can use plain fields here too -->
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_text">Offers</span>
                                <span class="o_stat_value">
                                    <!-- Could add widget="line_count" to the field if not in this class -->
                                    <field name="offer_count" string="Offers"/>
                                </span>
                            </div>
                        </button>
                    </div>
                    <h1>
                        <field name="name"/>
                    </h1>
                    <notebook>
                        <page string="Properties">
                            <field name="property_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="expected_price"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- List view for property types -->
    <record id="estate_property_type_view_list" model="ir.ui.view">
        <field name="name">estate_property_type_view_list</field>
        <field name="model">estate.property.type</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="property_ids"/>
                <field name="offer_count"/>
            </list>
        </field>
    </record>
</odoo>
