<odoo>
    <!-- Custom search view for the property model -->
    <record id="estate_property_view_search" model="ir.ui.view">
        <field name="name">estate.property.view.search</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <search>
                <!-- new properties on if state == new or received but no others-->
                <filter string="Available Properties" name="state" domain="['|', ('state', '=', 'new'), ('state', '=', 'received')]"/>
                <!-- group by postcode -->
                <filter name="group_by_postcode" context="{'group_by': 'postcode'}"/>
                <!-- Searchable fields -->
                <field name="name"/>
                <field name="property_type_id" string="Property Type"/>
                <field name="postcode"/>
                <field name="expected_price"/>
                <field name="bedrooms"/>
                <field name="living_area"/>
                <field name="facades"/>
            </search>
        </field>
    </record>
    
    <!-- Custom list view for the property model -->
    <record id="estate_property_view_list" model="ir.ui.view">
        <field name="name">estate.property.view.list</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" string="Title"/>
                <field name="property_type_id" string="Property Type"/>
                <field name="postcode"/>
                <field name="bedrooms"/>
                <field name="living_area" string="Living Area"/>
                <field name="expected_price" string="Expected Price"/>
                <field name="selling_price" string="Selling Price"/>
                <field name="date_availability" string="Date Availability"/>
                <field name="tag_ids" widget="many2many_tags"/>
            </list>
        </field>
    </record>

    <!-- Custom form view for the property model -->
    <record id="estate_property_view_form" model="ir.ui.view">
        <field name="name">estate.property.view.form</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <form string="Property">
                <header>
                    <!-- Sold and Canceled buttons -->
                    <!-- Not having title set throws warnings, though no errors -->
                    <button string="Sold" name="mark_sold" type="object" title="sold"/>
                    <button string="Cancel" name="mark_canceled" type="object" title="cancel"/>
                </header>
                <sheet>
                    <!-- Label applies to the group and appears above the name -->
                    <label for="name" string="Name"/>
                    <group>
                        <h1>
                            <!-- Will not have its own label. -->
                            <field name="name"/>
                        </h1>
                    </group>
                    <group>
                        <field name="tag_ids" widget="many2many_tags"/>
                    </group>
                    <group>
                        <group>
                            <field name="state" string="Status"/>
                            <field name="property_type_id" string="Property Type"/>
                            <field name="postcode"/>
                            <field name="date_availability" string="Date Availability"/>
                        </group>
                        <group>
                            <field name="expected_price" string="Expected Price"/>
                            <field name="selling_price" string="Selling Price"/>
                            <field name="best_price"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <group>
                                <field name="description"/>
                                <field name="bedrooms"/>
                                <field name="living_area" string="Living Area"/>
                                <field name="garage"/>
                                <field name="garden"/>
                                <field name="garden_area" string="Garden Area"/>
                                <field name="total_area" string="Total Area"/>
                            </group>
                        </page>
                        <page string="Offers">
                            <field name="offer_ids"/>
                        </page>
                        <page string="Other Info">
                            <group>
                                <field name="buyer"/>
                                <field name="salesperson"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ACTIONS -->

    <!-- Action for property model -->
    <record id="test_record" model="ir.actions.act_window">
        <field name="name">Property</field>
        <field name="res_model">estate.property</field>
        <!-- tree no longer exists, replacing with list and graph for this exercise. (Only admin can reach forms) -->
        <field name="view_mode">list,graph,form</field>
    </record>

    <!-- Property Type Submenu Action -->
    <record id="property_type_record" model="ir.actions.act_window">
        <field name="name">Property Type</field>
        <field name="res_model">estate.property.type</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Tag Submenu Action -->
    <record id="property_tag_record" model="ir.actions.act_window">
        <field name="name">Tags</field>
        <field name="res_model">estate.property.tag</field>
        <field name="view_mode">list</field>
    </record>

    <!-- Offers Submenu Action -->
    <record id="property_offer_record" model="ir.actions.act_window">
        <field name="name">Offers</field>
        <field name="res_model">estate.property.offer</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
