<odoo>
    <!-- Custom search view for the property model -->
    <record id="estate_property_view_search" model="ir.ui.view">
        <field name="name">estate.property.view.search</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <search>
                <!-- new properties on if state == new or received but no others-->
                <filter string="Available Properties" name="filter_available" 
                    domain="['|', ('state', '=', 'new'), ('state', '=', 'received')]"
                />
                <!-- group by postcode -->
                <filter name="group_by_postcode" context="{'group_by': 'postcode'}"/>
                <!-- Searchable fields -->
                <field name="name"/>
                <field name="property_type_id" string="Property Type"/>
                <field name="postcode"/>
                <field name="expected_price"/>
                <field name="bedrooms"/>
                <field name="living_area" filter_domain="[('living_area', '>=', self)]"/>
                <field name="facades"/>
            </search>
        </field>
    </record>
    
    <!-- Custom list view for the property model -->
    <record id="estate_property_view_list" model="ir.ui.view">
        <field name="name">estate.property.view.list</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <list decoration-success="state in ('received', 'accepted')" 
                decoration-bf="state == 'accepted'" 
                decoration-muted="state == 'sold'"
            >
                <field name="name" string="Title"/>
                <field name="property_type_id" string="Property Type"/>
                <field name="postcode"/>
                <field name="bedrooms"/>
                <field name="living_area" string="Living Area"/>
                <field name="expected_price" string="Expected Price"/>
                <field name="selling_price" string="Selling Price"/>
                <field name="date_availability" string="Date Availability" optional="1"/>
                <field name="tag_ids" 
                    widget="many2many_tags" 
                    options="{'color_field': 'color'}" 
                />
            </list>
        </field>
    </record>

    <!-- Custom form view for the property model -->
    <record id="estate_property_view_form" model="ir.ui.view">
        <field name="name">estate.property.view.form</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <form string="Property">
                <header>
                    <!-- Sold and Canceled buttons -->
                    <!-- Not having title set throws warnings, though no errors -->
                    <button string="Sold" 
                        name="mark_sold" 
                        type="object" 
                        title="sold" 
                        invisible="state in ('sold', 'canceled')"
                    />
                    <button string="Cancel" 
                        name="mark_canceled" 
                        type="object" 
                        title="cancel" 
                        invisible="state in ('sold', 'canceled')"
                    />
                    <field name="state" 
                        widget="statusbar" 
                        options="{'clickable': True}" 
                        statusbar_visible="new,received,accepted,sold"
                    />
                </header>
                <sheet>
                    <!-- Label applies to the group and appears above the name -->
                    <label for="name" string="Name"/>
                    <group>
                        <h1>
                            <!-- Will not have its own label. -->
                            <field name="name"/>
                        </h1>
                    </group>
                    <group>
                        <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                    </group>
                    <group>
                        <group>
                            <field name="property_type_id" 
                                string="Property Type" 
                                widget="many2one" 
                                options="{'no_create_edit': True, 'no_quick_create': True}"
                            />
                            <field name="postcode"/>
                            <field name="date_availability" string="Date Availability"/>
                        </group>
                        <group>
                            <field name="expected_price" string="Expected Price"/>
                            <field name="selling_price" string="Selling Price"/>
                            <field name="best_price"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <group>
                                <field name="description"/>
                                <field name="bedrooms"/>
                                <field name="living_area" string="Living Area"/>
                                <field name="garage"/>
                                <field name="garden"/>
                                <field name="garden_area" 
                                    string="Garden Area" 
                                    invisible="not garden"
                                />
                                <field name="garden_orientation" 
                                    string="Garden Orientation" 
                                    widget="radio" 
                                    invisible="not garden"
                                />
                                <field name="total_area" string="Total Area"/>
                            </group>
                        </page>
                        <page string="Offers">
                            <field name="offer_ids" readonly="state in ('accepted','sold','canceled')">
                                <list editable="bottom" 
                                    decoration-danger="status == 'refused'" 
                                    decoration-success="status == 'accepted'"
                                >
                                    <field name="price" editable="1"/>
                                    <field name="partner_id" string="Partner" editable="1"/>
                                    <field name="validity" editable="1"/>
                                    <field name="date_deadline" editable="1"/>
                                    <button name="mark_offer_accept" 
                                        type="object" 
                                        icon="check" 
                                        title="accept" 
                                        invisible="status" 
                                        editable="1"
                                    />
                                    <button name="mark_offer_refuse" 
                                        type="object" 
                                        icon="close" 
                                        title="refuse" 
                                        invisible="status" 
                                        editable="1"
                                    />
                                    <field name="status" editable="1" invisible="not status"/>
                                </list>
                            </field>
                        </page>
                        <page string="Other Info">
                            <group>
                                <field name="buyer"/>
                                <field name="salesperson"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <!-- Chatter -->
                <div class="oe_chatter"><chatter/></div>
            </form>
        </field>
    </record>

    <!-- ACTIONS -->

    <!-- Action for property model -->
    <record id="test_record" model="ir.actions.act_window">
        <field name="name">Property</field>
        <field name="res_model">estate.property</field>
        <!-- tree no longer exists, replacing with list and graph for this exercise. (Only admin can reach forms) -->
        <field name="view_mode">list,graph,form</field>
        <field name="context">{'search_default_filter_available': True}</field>
    </record>

    <!-- Property Type Submenu Action -->
    <record id="property_type_record" model="ir.actions.act_window">
        <field name="name">Property Type</field>
        <field name="res_model">estate.property.type</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Tag Submenu Action -->
    <record id="property_tag_record" model="ir.actions.act_window">
        <field name="name">Tags</field>
        <field name="res_model">estate.property.tag</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Offers Submenu Action -->
    <record id="property_offer_record" model="ir.actions.act_window">
        <field name="name">Offers</field>
        <field name="res_model">estate.property.offer</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
